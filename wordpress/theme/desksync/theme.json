{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": { "defaultPalette": false, "defaultGradients": false, "defaultDuotone": false,
      "palette": [
        { "slug": "ground", "name": "Ground", "color": "#e7e7e4" },
        { "slug": "card", "name": "Card", "color": "#ffffff" },
        { "slug": "ink", "name": "Ink", "color": "#141414" },
        { "slug": "muted", "name": "Muted", "color": "#5c5c58" },
        { "slug": "accent", "name": "Accent", "color": "#ffd84d" }
      ] },
    "typography": { "defaultFontSizes": false, "fontFamilies": [
      { "slug": "system", "name": "System", "fontFamily": "ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif" }
    ] },
    "layout": { "contentSize": "760px", "wideSize": "1120px" },
    "spacing": { "blockGap": false }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--ground)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system)", "fontSize": "16px", "lineHeight": "1.6" },
    "spacing": { "padding": { "top": "0", "bottom": "0", "left": "0", "right": "0" } }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
