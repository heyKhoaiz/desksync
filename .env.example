# Copy to .env (gitignored): cp .env.example .env
# From Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# For the Chrome Web Store build: where feedback goes, and the public privacy policy page
SUPPORT_EMAIL=
PRIVACY_URL=
# The page that explains Pro, linked from Settings (e.g. https://desksync.org/#pro)
PRO_URL=
# The extension's Chrome Web Store page, once published (the site's install button)
STORE_URL=
# The website's own domain
SITE_DOMAIN=
# The VPS that serves it (an ssh host name; see deploy/vps/)
VPS_HOST=khoaiz-vps
# For `make admin` only (accounts and giving Pro, on this computer). Supabase -> Project Settings ->
# API Keys -> secret key. It can read and change every account: never in the extension, site or git.
SUPABASE_SERVICE_ROLE_KEY=
