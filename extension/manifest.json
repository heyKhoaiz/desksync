{
  "manifest_version": 3,
  "name": "DeskSync – Notes, Read Later, Clipboard & Vault",
  "short_name": "DeskSync",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Notes, read-later tabs, clipboard history and an encrypted password vault — synced across every Chrome profile and your phone.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeskSync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html?view=panel"
  },
  "omnibox": { "keyword": "ds" },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "contextMenus", "alarms", "clipboardRead", "clipboardWrite", "scripting", "sidePanel", "favicon"],
  "optional_host_permissions": ["*://*/*"],
  "commands": {
    "save-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save current tab to Read Later"
    },
    "new-note": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Start a new note"
    },
    "save-clipboard": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Save the clipboard as a clip"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
